# map-project-infra — .env 본보기. 실제 값은 `.env` 에 두고 저장소에 올리지 않는다.
#
# 빠른 시작: ./scripts/make-local-env.sh 가 이 파일을 복사해 비밀번호·토큰·암호 열쇠를
# 이 기계에서만 쓰는 무작위값으로 채운 .env 를 만든다. 비밀값 자리는 그래서 비어 있다.
#
# **로컬 실행용 기본값이다 — 외부에 열기 전에 반드시 인증(*_AUTH_ENFORCED)을 켜고,
# 서명 열쇠·토큰을 다시 만들고, CORS 출처(USER_CORS_ALLOWED_ORIGINS)를 좁힌다.**
# 기본값은 외부 유료 API 를 부르지 않는다. 외부 API 는 자기 키를 넣을 때만 불린다.

# (1) PostgreSQL
MAP_PROJECT_POSTGRES_DB=map
MAP_PROJECT_POSTGRES_USER=map
MAP_PROJECT_POSTGRES_PASSWORD=
MAP_PROJECT_POSTGRES_HOST=postgres
MAP_PROJECT_POSTGRES_PORT=5432

# hub 는 이 값을 기본값 없이 필수로 읽는다. 비어 있으면 설정 검증에서 걸려
# 컨테이너가 부팅하지 못하므로, 템플릿을 복사한 직후에도 바로 뜨도록 넣어 둔다.
# 드라이버 이름(psycopg)을 바꾸지 않는다. 다른 이름을 적으면 hub 는 그대로
# 뜨고 상태 확인도 정상으로 나오는데, 예약해 둔 수집 작업만 조용히 실패한다.
# 서빙은 객체를 만들 수 없는 실행 역할로 붙는다. 마이그레이션 자격(HUB_MIGRATION_DATABASE_URL)은
# 아래 일회성 단계에만 넘긴다. 두 값 모두 scripts/make-local-env.sh 가 채운다.
HUB_DATABASE_URL=
HUB_MIGRATION_DATABASE_URL=

# HUB_PLACES_STUB_MODE: 외부 발급처 호출을 전부 결정적 스텁으로 대체한다. 빠른 시작은 키 없이
#   돌므로 켜 둔다. 실제 외부 데이터를 쓰려면 false 로 두고 아래 키를 넣는다.
#   비워 두지 않는다 — 빈 값은 불리언으로 읽히지 않아 hub 가 부팅하지 못한다.
HUB_PLACES_STUB_MODE=true
# 저장 본문 암호화. 일정과 추천 결과 본문에는 사용자가 어디를 다니는지가 좌표와
# 함께 들어 있어, 저장소 파일이나 백업이 통째로 빠져나가면 그대로 읽힌다.
# 켜 두었는데 키가 없으면 BFF 가 부팅하지 않는다 — 켠 줄 알고 평문으로 쌓이는
# 상태를 만들지 않기 위해서다.
#
# 키는 32바이트여야 한다. 아래처럼 만든다.
#   openssl rand -base64 32
# 여러 개를 두는 것은 키를 바꾸는 동안 옛 키로 쓴 값을 계속 읽기 위해서다.
# 바꾸는 순서: 새 키를 KEYS 에 먼저 넣어 배포 → 다음 배포에서 ACTIVE_KID 를 옮긴다.
# 한 번에 하면 아직 새 키를 모르는 인스턴스가 그 값을 읽지 못한다.
# 옛 키를 KEYS 에서 지우는 순간 그 키로 쓴 값은 영영 읽을 수 없다.
USER_LOCATION_ENC_ENABLED=true
USER_LOCATION_ENC_ACTIVE_KID=k1
USER_LOCATION_ENC_KEYS=
# 서비스 사이로 오가는 좌표를 감싸는 열쇠. BFF 와 hub 가 같은 값을 나눠 가진다.
# 저장에 쓰는 열쇠와 반드시 다른 값으로 둔다 — 하나로 합치면 좌표를 받아 쓰는
# 서비스가 뚫렸을 때 저장된 것까지 함께 열린다.
#
# 32바이트로 풀리는 base64 여야 한다: openssl rand -base64 32
# 이 값이 있으면 hub 는 감싼 좌표만 받는다. 값으로 온 좌표는 거절한다 —
# 못 열었을 때 평문으로 물러서면 감싸는 쪽이 고장 나도 아무도 알아차리지 못한다.
USER_LOCATION_WIRE_ENABLED=true
MAP_PROJECT_LOCATION_WIRE_KEY=

# agent 가 대화 상태(체크포인트)를 저장할 때 쓰는 봉인 열쇠. 형식은
# USER_LOCATION_ENC_KEYS 와 같은 "kid:base64" 쉼표 목록이며, 각 값은 32바이트로
# 풀려야 한다(openssl rand -base64 32). 위 열쇠들과 다른 값이어야 한다 —
# MAP_PROJECT_LOCATION_WIRE_KEY 와 같으면 agent 가 부팅을 거부한다.
AGENT_CHECKPOINT_ENC_ACTIVE_KID=k1
AGENT_CHECKPOINT_ENC_KEYS=
# BFF 가 봉투를 열 때 보는 나이 상한(초). 스트림에 밀린 값을 살리려고
# 보내는 쪽 만료(300초)보다 느슨하다. 0 이면 나이를 보지 않는다.
#USER_LOCATION_WIRE_MAX_AGE_SECONDS=3600

# (2) Redis (단일 인스턴스, DB 번호로 용도 분리 — 코드 RedisConfig 기준)
# DB0=기본/세션 / DB1=JWT 블랙리스트 / DB2=Streams / DB3=rate-limit+카운터 /
# DB4=BFF 초안(draft) + hub 외부데이터 캐시(공유) / DB5=채팅 / DB6=BFF 재사용 캐시
# (채팅 발행/구독 채널은 논리 DB 무관하게 동작하며, DB5 는 채팅 전용 연결에 할당된 값)
#
# 접속 정보를 읽는 키가 서비스마다 다르다.
#   USER_REDIS_HOST/USER_REDIS_PORT — user-BFF 전용
#   MAP_PROJECT_REDIS_URL             — hub · agent
#   ADMIN_REDIS_URL       — admin (아래 (8.5) 절)
USER_REDIS_HOST=redis
USER_REDIS_PORT=6379
MAP_PROJECT_REDIS_URL=redis://redis:6379
# 비우면 무인증(현행). 값을 채우면 redis 컨테이너와 user-BFF 에만 적용되므로,
# hub·agent·admin 은 위 URL 들을 redis://:<PW>@redis:6379 형태로 함께 고쳐야 한다.
MAP_PROJECT_REDIS_PASSWORD=

# (3) 내부 서비스 인증·라우팅
MAP_PROJECT_INTERNAL_SERVICE_TOKEN=
# Hub 수동 폴링·격자·금지구역 관리는 일반 서비스/User 관리자와 다른 자격 사용
MAP_PROJECT_HUB_ADMIN_INTERNAL_TOKEN=
# Admin→User only, distinct per environment. No fallback to the ordinary token.
MAP_PROJECT_USER_ADMIN_INTERNAL_TOKEN=
# User ordinary Hub requests retain 5s; directions use one 20s budget per <=20-leg batch.
# Agent continues to use AGENT_HUB_TIMEOUT_SECONDS independently.
USER_HUB_TIMEOUT_SECONDS=5
USER_HUB_DIRECTIONS_TIMEOUT_SECONDS=20
# HUB_INTERNAL_TRUSTED_CIDRS: hub 의 /internal/* 호출을 허용할 대역. 토큰과 함께
#   이중 관문으로 동작하며, 둘 중 하나라도 틀리면 403 이다.
HUB_INTERNAL_TRUSTED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# BFF 도 같은 규약을 쓴다. 코드가 읽는데 여기 자리가 없었다.
# USER_INTERNAL_TRUSTED_CIDRS: 내부 관리 호출을 받아 줄 대역.
# USER_RATELIMIT_TRUSTED_PROXIES: 요청자 주소를 헤더에서 읽어도 되는 앞단의 대역.
#   여기 없는 곳에서 온 헤더는 믿지 않는다. 루프백이 들어가는 것은 같은 기계의
#   관문을 거쳐 들어오기 때문이다.
USER_INTERNAL_TRUSTED_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
USER_RATELIMIT_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8
# 서비스 사이 호출은 프록시의 내부 창구를 거친다. 상대를 새 판으로 바꾸는
# 동안에도 이 주소는 그대로이고, 프록시가 바뀐 쪽으로 넘긴다. 경로는 이
# 주소 뒤에 / 로 시작해서 붙는다.
MAP_PROJECT_AGENT_BASE_URL=http://proxy:8081/agent
MAP_PROJECT_HUB_BASE_URL=http://proxy:8081/hub
ADMIN_USER_BASE_URL=http://proxy:8081/user
# 카메라 인식 서비스. 현재 이 주소를 읽는 서버는 없다(클라이언트가 관문의
# /ws/vision 으로 직접 붙고, nginx 는 자기 설정 파일에 주소를 갖고 있다).
# 스택 안에서의 위치를 문서로 남겨 두는 항목이다.

# (4) JWT (user 전용) — user 서비스 서명 알고리즘은 RS256
# USER_AUTH_ENFORCED=false(기본) 이면 두 키가 비어도 부팅한다(임시 키쌍 생성 — 재기동 시 기존
# 토큰 전부 무효). USER_AUTH_ENFORCED=true 로 올리려면 두 키가 반드시 채워져야 하며,
# 비어 있으면 AuthStartupValidator 가 부팅을 중단시킨다.
# RS256 개인키 (PKCS8 Base64, 개행 없이 한 줄)
USER_JWT_PRIVATE_KEY=
# RS256 공개키 (X509 Base64, 개행 없이 한 줄)
USER_JWT_PUBLIC_KEY=
USER_JWT_ACCESS_TTL=3600
USER_JWT_REFRESH_TTL=2592000

# (5) 외부 API 키
# Kakao 로그인: 앱이 카카오 SDK 로 로그인해 액세스 토큰을 들고 오므로 서버는 인가 주소를
# 만들지 않는다. APP_ID 는 콘솔의 앱 번호이며, 받은 토큰이 우리 앱 것인지 대조하는 데 쓴다.
# 비우면 카카오 로그인만 닫히고 나머지 로그인 수단은 그대로 열린다.
USER_KAKAO_APP_ID=
# 조회 주소(선택 — 미설정 시 기본값). 값이 바뀌면 사용자 토큰이 나가는 곳이 바뀐다.
USER_KAKAO_TOKEN_INFO_URI=https://kapi.kakao.com/v1/user/access_token_info
USER_KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
# 아래는 로그인과 무관한 Kakao Local(주소·장소 검색) 키다.
MAP_PROJECT_KAKAO_REST_API_KEY=
MAP_PROJECT_KMA_SERVICE_KEY=
# HUB_AIRKOREA_SERVICE_KEY: 대기질 조회용. 비우면 MAP_PROJECT_KMA_SERVICE_KEY 를 대신 쓴다.
#                       별도로 신청한 키가 있으면 여기에 채운다.
HUB_AIRKOREA_SERVICE_KEY=
# HUB_AIR_POLL_ENABLED: 대기질 배경 폴링 여부. 발급처 한도가 키 단위여서, 같은 키를
#                   쓰는 환경이 둘이면 두 배로 불러 하루 중 늦은 시간대가 통째로
#                   막힌다. 운영만 true 로 두고 시험 환경은 false 로 둔다.
HUB_AIR_POLL_ENABLED=true
MAP_PROJECT_TOUR_API_SERVICE_KEY=
MAP_PROJECT_NAVER_CLIENT_ID=
MAP_PROJECT_NAVER_CLIENT_SECRET=
# HUB_GOOGLE_MAPS_API_KEY: 장소 사진 전용(Places API (New)). 비우면 사진만 스텁으로 빠지고
#   화면의 나머지는 그대로 나간다. 사진 주소 발급이 건당 과금이라 하루 상한을 건다.
HUB_GOOGLE_MAPS_API_KEY=
HUB_GOOGLE_PHOTOS_DAILY_MEDIA_CAP=32
MAP_PROJECT_GEMINI_API_KEY=
# 모델명은 agent 와 yolo 가 이 한 값을 같이 읽는다. 두 서비스 코드에도 기본값이
# 있지만 이 설정이 있으면 이 값이 쓰인다. 모델을 바꿀 때는 바로 아래
# AGENT_GEMINI_THINKING_BUDGET 도 함께 본다.
#
#   gemini-3.5-flash-lite 이 본보기의 값. 구조화 JSON 출력과 이미지 입력을 지원한다.
#   gemini-3.8-flash     두 서비스 코드의 기본값. 이 모델로 돌릴 때는
#                        AGENT_GEMINI_THINKING_BUDGET 을 0 으로 둔다 — -1 이면 기본
#                        thinking 이 붙어 비싸진다.
#   단가·제공 여부는 발급처 공지가 바뀌므로 쓰기 전에 발급처 문서로 확인한다.
MAP_PROJECT_GEMINI_MODEL=gemini-3.5-flash-lite
# AGENT_LLM_PROVIDER: fake(기본) 는 키·네트워크·비용 없이 결정적인 합성 결과를 낸다(결과에
#   synthetic 표시). gemini 로 바꾸면 위 키로 실제 모델을 부른다.
AGENT_LLM_PROVIDER=fake
# AGENT_CHECKPOINT_ENABLED: 대화 상태를 Postgres 에 저장한다. 빠른 시작은 끈다 — 켜려면 먼저
#   agent 마이그레이션(python -m map_project_agent.checkpoint_migrate)을 돌린다.
AGENT_CHECKPOINT_ENABLED=false
# AGENT_GEMINI_THINKING_BUDGET: agent 의 구조화 호출에 보낼 thinking 예산. 음수면 thinking
#   설정을 아예 보내지 않아 모델 기본값을 쓴다(3.5 Flash-Lite 는 가장 낮은 minimal).
#   0 은 옛 2.5 계열의 '끄기' 값인데 3.5 Flash-Lite 는 이 값을 400 으로 거절해 추천·
#   후기 요약이 모두 실패한다. yolo 는 이 값을 읽지 않는다.
AGENT_GEMINI_THINKING_BUDGET=-1
# 호출 상한 두 가지. 기본값은 무료 등급을 전제로 잡혀 있어, 유료로 올려도
# 여기를 함께 올리지 않으면 늘어난 한도를 쓰지 못한다. agent 가 자기 쪽에서
# 먼저 막기 때문이다.
#
# MAP_PROJECT_GEMINI_RPD_CAP: 하루 상한. 발급처 한도보다 낮게 잡아 여유를 남긴다.
#   산식 — 일정 1건이 추천 2회(장소 선정·이유) + 요약 1회 = 3회를 쓴다.
#   하루 N건을 받으려면 N × 3 이 필요하다.
#     하루   100건 →   300
#     하루 2,000건 → 6,000
#   기본 200 은 하루 60여 건까지만 감당한다.
#
# AGENT_GEMINI_RPM_LIMIT: 분당 상한. 이것이 실질 동시 처리량을 정한다.
#   한 건이 3회를 쓰므로 분당 10 이면 동시에 3건 남짓이 한계다. 넘으면
#   최대 60초 기다린 뒤 실패한다 — 조용히 느려지는 것이 아니라 끊긴다.
#   낮보다 밤에 몰리는 서비스라 하루 평균으로 잡으면 저녁에 막힌다.
#   피크를 평균의 3배 이상으로 보고 여유를 두는 편이 낫다.
MAP_PROJECT_GEMINI_RPD_CAP=200
AGENT_GEMINI_RPM_LIMIT=10
# HUB_ODSAY_API_KEY: 지하철 경로 탐색용. 비우면 경로 조회가 고정 스텁으로 빠진다.
#   발급처가 앱 등록마다 URI·서버·Android·iOS 별로 키를 따로 내주는데, 요청에는
#   어느 쪽인지 실리지 않아 어떤 키를 넣어도 서버에서 호출된다. 등록해 둔 쓰임에
#   맞추려면 서버용 키를 받아 채운다.
#   무료 등급의 하루 호출 수가 적어 hub 가 좌표 단위로 캐시하고 하루 상한을 건다.
HUB_ODSAY_API_KEY=
# HUB_ODSAY_API_KEY_FALLBACK: 예비 키. 비워 두면 폴백 없이 동작한다.
#   발급처는 등록해 둔 쓰임과 요청이 맞지 않으면 키 인증 자체를 거절한다.
#   콘솔에서 플랫폼 키를 정리하거나 등록 정보를 바꾸는 순간 한쪽이 막힐 수
#   있어, 그때 기능이 통째로 죽는 대신 다른 키로 한 번 더 시도하게 한다.
#   키에 얽힌 실패에만 다시 부르며, 그 호출도 하루 상한을 함께 쓴다.
HUB_ODSAY_API_KEY_FALLBACK=
HUB_ODSAY_DAILY_CALL_CAP=900
# HUB_SEOUL_OPENAPI_KEY: 서울 열린데이터광장 인증키. 지금은 따릉이 대여소 현황에 쓴다.
#   비우면 대여소 목록이 고정 스텁으로 빠진다. 발급처가 https 를 받지 않아
#   hub 에서 나가는 이 호출만 평문이다 — 그래서 앱이 직접 부르지 않는다.
#   전체 목록이 한 번에 오지 않아 나눠 받은 뒤 통째로 캐시하고, 요청한 좌표
#   주변만 잘라서 돌려준다. 캐시가 짧을수록 하루 호출 수가 비례해 늘어난다.
HUB_SEOUL_OPENAPI_KEY=
HUB_SEOUL_BIKE_CACHE_TTL_SEC=300
# HUB_PM_SERVICE_KEY: 공유 킥보드(국토교통부 퍼스널모빌리티) 조회용 data.go.kr 키.
#   비우면 MAP_PROJECT_KMA_SERVICE_KEY 를 대신 쓴다 — 한 계정 키로 여러 서비스가 열려
#   있는 경우가 흔해서다. 둘 다 비면 스텁으로 빠진다.
#   발급처가 사업자명을 필수로 받고 목록을 주는 오퍼레이션이 없어, 조회할
#   사업자를 아래에 적어 둔다. 한 번 조회에 사업자 수만큼 호출이 나간다.
HUB_PM_SERVICE_KEY=
HUB_PM_PROVIDERS=Beam,GCOO,SWING,씽씽,킥고잉,Lime,지쿠,알파카
HUB_PM_CACHE_TTL_SEC=120

# (5c) 카메라 인식 서비스 (yolo — WebSocket /ws/vision, compose `vision` 프로파일)
# YOLO_GEMINI_API_KEY: 비워 두면 위 공용 MAP_PROJECT_GEMINI_API_KEY 를 그대로 쓴다.
#   agent 는 자기 호출량만 세어 일일 한도를 관리하므로, 같은 키를 카메라
#   인식이 나눠 쓰면 agent 가 한도 안이라고 믿는 상태에서 실제로는 거부당한다.
#   분리하려면 별도 키를 발급해 여기에 채운다.
# YOLO_*_SECONDS: 카메라 인식 전용 타임아웃. agent 의 같은 뜻 값
#   (AGENT_GEMINI_TIMEOUT_SECONDS · AGENT_JOB_TIMEOUT_SECONDS)과 따로 둔다.
#   JOB 이 GEMINI 보다 커야 한다 — 같으면 식별을 마치고도 검색 도중 잘려
#   이미 얻은 결과가 통째로 버려진다.
# YOLO_WS_MAX_JOBS: 연결 하나가 돌릴 수 있는 인식 횟수. 사용자 인증과 user 의 승인을
#   거친 연결이라도 상한이 없으면 연결 하나로 모델 호출 한도를 소진할 수 있다.
# YOLO_WIKIPEDIA_CONTACT: 위키백과 검색 때 보내는 운영자 연락처(URL 또는 이메일).
#   비워 두면 위키백과를 부르지 않는다.
YOLO_GEMINI_API_KEY=
YOLO_GEMINI_TIMEOUT_SECONDS=25.0
YOLO_JOB_TIMEOUT_SECONDS=45.0
YOLO_WS_MAX_JOBS=60
YOLO_WIKIPEDIA_CONTACT=

# (5d) 카메라 인식 모델 (yolo)
# YOLO_MODEL_PATH: 컨테이너 안 가중치 경로. 이미지에 내장되므로 보통 그대로 둔다.
# YOLO_CONFIDENCE: 탐지로 인정할 최소 신뢰도(0.0~1.0).
YOLO_MODEL_PATH=models/yolo11n.pt
YOLO_CONFIDENCE=0.5

# (5b) 경로 라우팅 (자체 호스팅 OSRM)
# 도보(foot)/자전거(bicycle) 프로파일 OSRM 인스턴스의 base URL.
# 비워 두면 hub 가 결정적 스텁 지오메트리로 폴백한다(데이터 빌드 전 검증용).
# scripts/osrm-rebuild.sh 로 데이터를 빌드하고
# `docker compose --profile routing up -d` 로 기동한 뒤 아래를 채우고 hub 재기동:
#   MAP_PROJECT_OSRM_FOOT_BASE_URL=http://osrm-foot:5000
#   MAP_PROJECT_OSRM_BICYCLE_BASE_URL=http://osrm-bicycle:5000
MAP_PROJECT_OSRM_FOOT_BASE_URL=
MAP_PROJECT_OSRM_BICYCLE_BASE_URL=

# (6) 모드·메타
# AGENT_LANGGRAPH_SCHEMA: agent 체크포인터가 사용하는 Postgres 스키마명.
AGENT_LANGGRAPH_SCHEMA=langgraph
# *_LOG_LEVEL: 서비스별 루트 로거 레벨. 비우면 INFO. uvicorn 은 자기 로거만 설정하고
#            루트 로거에는 핸들러를 붙이지 않으므로, agent 가 부팅 시 루트 핸들러가
#            비어 있을 때만 stdout 핸들러를 붙여 앱 로그를 살린다.
AGENT_LOG_LEVEL=INFO
HUB_LOG_LEVEL=INFO
YOLO_LOG_LEVEL=INFO

# (6a) agent 기능 스위치
# 장애가 나거나 추천 품질이 나빠졌을 때 재배포 없이 즉시 끄기 위한 값이다.
# 다섯 다 코드에 기본값 true 가 있어 비워 두어도 지금과 똑같이 동작하지만,
# 키가 여기 없으면 끌 방법 자체가 없다. 그래서 기본값을 그대로 적어 둔다.
#
# AGENT_RULES_ENABLED: 이동수단 반경 필터와 실내 가점 랭킹. false 면 두 노드가
#   후보를 손대지 않고 그대로 통과시킨다.
# AGENT_TIMELINE_ENABLED: 체류시간·방문 시각 계산. false 면 계산을 건너뛰어
#   시간축이 붙기 전과 같은 응답이 나간다.
# AGENT_REVIEWS_ENRICH_ENABLED: 장소를 고르고 이유를 쓸 때 블로그 후기 스니펫을
#   근거로 붙이는 보강. false 면 후기 조회를 아예 하지 않는다.
# AGENT_SUMMARY_ENABLED: 장소별 후기 요약. false 면 요약을 만들지 않고 빈 결과를
#   준다. 빈 결과는 부르는 쪽이 캐시하지 않으므로 되돌리면 바로 정상으로
#   돌아온다.
# AGENT_PERSONALIZATION_ENABLED: 테마 친화 가점. false 면 가점을 0 으로 계산해
#   응답이 도입 전과 같아진다. 가점이 랭킹 노드 안에 있어 AGENT_RULES_ENABLED 를
#   끄면 이것도 함께 꺼진다.
AGENT_RULES_ENABLED=true
AGENT_TIMELINE_ENABLED=true
AGENT_REVIEWS_ENRICH_ENABLED=false
AGENT_SUMMARY_ENABLED=false
AGENT_PERSONALIZATION_ENABLED=true

# (6b) 동기 trip facade 타임아웃 (user-BFF)
# USER_TRIP_POLL_TIMEOUT_SECONDS: BFF 가 agent draft 를 기다리는 상한(초).
#   대기 상한 순서는 client(180) > 터널(120) > BFF(본 값) > 통상 완료 시간이어야
#   한다. 터널이 사이에 있다는 점이 중요하다 — 퀵터널은 원본 응답을 120초까지만
#   기다리고 끊는다. 본 값이 그보다 크면, 서버가 아직 기다리는 중에 터널이 먼저
#   끊어 사용자에게는 사유 없는 실패로 보인다. 서버가 스스로 시간초과를 내려면
#   터널보다 짧아야 한다.
#   본 값이 client 보다 길면 client 가 버린 요청을 서버가 계속 폴링한다.
#   agent 쪽 잡 상한(AGENT_JOB_TIMEOUT_SECONDS=300)은 별개로 더 길다.
#   터널을 쓰지 않는 곳에 올리면 다시 늘려도 된다.
USER_TRIP_POLL_TIMEOUT_SECONDS=110

# (8) admin 운영 콘솔 (JSON API + 화면)
# MAP_PROJECT_ADMIN_DB_PASSWORD 는 db/init/10-admin.sh 의 map_admin 역할 비밀번호이며,
# ADMIN_DATABASE_URL 의 비밀번호와 반드시 동일해야 한다(단일 출처).
MAP_PROJECT_ADMIN_DB_PASSWORD=
ADMIN_DATABASE_URL=
# DB 조회 타임아웃(초).
ADMIN_DB_TIMEOUT_SEC=5.0

# 운영자 인증: admin_accounts(bcrypt) + 서버측 세션(HttpOnly 쿠키).
# [필수] admin_accounts 가 비어 있을 때만 아래 자격으로 최초 계정 1회 시드한다.
#        비워 두면 계정이 생성되지 않아 콘솔에 아무도 로그인할 수 없다.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_ENVIRONMENT=test
# Server-only per-environment connections; never put credentials in frontend config.
ADMIN_TARGETS={}
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_SECONDS=300

# 학습 파이프라인은 보류. 승인된 재개 전에는 캡처/Streams 학습발행을 끈다.
MAP_PROJECT_TRAINING_CAPTURE_ENABLED=false
MAP_PROJECT_VISION_INTERNAL_TOKEN=
YOLO_USER_SERVICE_BASE_URL=http://user:8080
YOLO_PERMIT_TIMEOUT_SECONDS=5
YOLO_MAX_CONCURRENT_JOBS=2
YOLO_WS_IDLE_TIMEOUT_SECONDS=120
YOLO_WS_MAX_MESSAGES_PER_CONNECTION=240
# 세션 수명(분). 기본 720 = 12시간.
ADMIN_SESSION_TTL_MIN=720
# 로컬 http 실행용으로만 false 다 — 외부에 열기 전 true 로 둔다. 키를 지우면 compose
# 기본값(true)이 쓰인다. http 로 연 콘솔에서 true 면 브라우저가 쿠키를 저장하지 않아
# 로그인 직후 곧바로 튕긴다.
ADMIN_SESSION_COOKIE_SECURE=false
# dev SPA(Vite) 교차출처 허용 목록. 프로덕션은 nginx same-origin 이라 쓰지 않는다.
# JSON 배열 복합 타입이라 `ADMIN_CORS_ORIGINS=` 처럼 빈 값을 남기면 admin 이
# SettingsError 로 뜨지 못한다. 안 쓸 때는 아래처럼 주석으로 둔다.
# ADMIN_CORS_ORIGINS=["http://localhost:5173"]
# Redis 진단 읽기전용(스트림·Gemini 쿼터·캐시 조회).
ADMIN_REDIS_URL=redis://redis:6379
# Grafana 패널 임베드 슬롯(JSON 배열). 키를 주석 처리하면 콘솔에서 모니터링 탭을 숨긴다.
# ADMIN_CORS_ORIGINS 와 같은 복합 타입이라 `ADMIN_MONITORING_PANELS=` 빈 값은 SettingsError 다.
# ADMIN_MONITORING_PANELS=[{"title":"개요","url":"http://127.0.0.1:3000/d/map-overview"}]
#
# 여기 적는 주소는 **보는 사람의 브라우저가 여는 주소**다. 콘솔이 대신
# 불러다 주는 것이 아니라 화면 안에 창을 하나 열어 그 주소로 직접 간다.
#
# 그래서 서버에 올린 것을 접속 통로로 볼 때는, 서버 안의 포트가 아니라
# 내 컴퓨터에서 통로가 열린 포트를 적어야 한다. 서버 안의 포트를 그대로
# 적으면 창만 빈 채로 뜨고, 어디가 잘못됐는지는 아무 데도 남지 않는다.

# (8.6) 모니터링 스택 (compose `monitoring` 프로파일)
# docker-compose.admin.yml 이 직접 참조하는 키다. Grafana 초기 관리자 자격과 노출 포트.
MAP_PROJECT_GRAFANA_ADMIN_USER=admin
MAP_PROJECT_GRAFANA_ADMIN_PASSWORD=
MAP_PROJECT_GRAFANA_PORT=3000

# (8.4) 후기 요약 (BFF) — 값은 전부 선택. 비우면 application.yml 기본값을 쓴다.
# SUMMARY_TTL_SECONDS: 요약 캐시 보관 시간(초).
# PREWARM_*: 일정 생성 직후 요약을 미리 만들어 두는 동작.
#            ENABLED 를 false 로 하면 요약은 화면에서 열 때만 만들어진다.
USER_REVIEWS_SUMMARY_TTL_SECONDS=86400
USER_REVIEWS_PREWARM_ENABLED=false
USER_REVIEWS_PREWARM_POOL_SIZE=1
USER_REVIEWS_PREWARM_QUEUE_CAPACITY=50
USER_REVIEWS_PREWARM_MAX_PLACES=7
USER_REVIEWS_PREWARM_BATCH_SIZE=7

# (8.5) 채팅 (실시간 채팅) — 상세 설정은 user 의 기본값 사용
# USER_CHAT_INVITE_BASE_URL: 초대 링크 기준 주소.
#                       경로는 앱 라우트(/invite/{토큰})와 같아야 한다 — 다르면
#                       링크를 눌러도 앱이 그 화면을 찾지 못한다.
#                       도메인은 앱 링크 검증 파일(assetlinks.json)을 올려 둔 곳과
#                       같아야 한다. 어긋나면 검증이 조용히 실패해 링크가 앱 대신
#                       브라우저로 열린다. 영구 호스트가 정해지면 이 값만 바꾸면 된다.
# 기본값이 없다. 비워 두면 초대 링크 주소를 만들지 않는다.
USER_CHAT_INVITE_BASE_URL=
# USER_CHAT_MAX_MESSAGE_LENGTH: 텍스트 메시지 최대 글자 수(초과 시 400 거부)
USER_CHAT_MAX_MESSAGE_LENGTH=2000
# USER_CHAT_INVITE_TTL_DAYS: 발급한 초대 링크가 며칠 뒤 스스로 만료되는지.
#                       방 만료와 별개이며 실제 유효기간은 둘 중 이른 쪽이다.
USER_CHAT_INVITE_TTL_DAYS=7
# USER_CHAT_INVITE_PREVIEW_RATE_LIMIT / _WINDOW_SECONDS:
#   초대 미리보기는 로그인 없이 호출할 수 있어 사용자 단위로 셀 수 없다.
#   발신 주소 기준으로 창당 몇 번까지 허용할지 정한다.
USER_CHAT_INVITE_PREVIEW_RATE_LIMIT=30
USER_CHAT_INVITE_PREVIEW_RATE_WINDOW_SECONDS=60

# (9) 보안 (CORS / 인증 강제)
# USER_CORS_ALLOWED_ORIGINS: 운영 시 명시 도메인으로 제한
USER_CORS_ALLOWED_ORIGINS=*
# 인증 강제는 서비스마다 따로 켠다.
USER_AUTH_ENFORCED=false
AGENT_AUTH_ENFORCED=false
HUB_AUTH_ENFORCED=false

# (10) 테스터 계정 시더 (user BFF)
# USER_TESTER_SEED_ENABLED=true 로 두면 user 가 부팅할 때마다
#   maptester1@example.com ~ maptester5@example.com 5개 계정을 보장한다.
#   없으면 만들고, 비밀번호가 표준값과 어긋나 있으면 되돌린다. 닉네임과 나머지
#   프로필은 만들 때만 넣고 이후 건드리지 않는다 — 내 정보 화면에서 바꾼 값이
#   부팅마다 되돌아가면 안 되기 때문이다.
#   데이터 볼륨을 지워도(compose down -v) 다시 띄우면 그대로 되살아난다.
#   기본 false. 운영에서는 켜지 않는다 — 비밀번호를 팀이 공유하는 계정이 5개 생긴다.
# USER_TESTER_SEED_PASSWORD: 5개 계정 공통 비밀번호. 비워 두면 켜져 있어도 경고만 남기고
#   계정을 만들지 않는다(평문 비밀번호를 소스에 남기지 않으려고 기본값을 두지 않았다).
#   값을 바꾸면 다음 부팅에서 기존 5개 계정의 해시가 새 값으로 교체된다.
USER_TESTER_SEED_ENABLED=false
USER_TESTER_SEED_PASSWORD=

# ── 앞단(edge) — 바깥에서 부를 주소와 인증서 ─────────────────────────────
# EDGE_* 는 docker-compose.edge.yml 을 함께 얹을 때만 쓴다. 얹지 않으면 값은
# 없어도 된다.
#
# 얹은 파일의 값을 비워 두면 기동이 그 자리에서 멈춘다. 앞단이 주소를 모르는 채로
# 뜨면 인증서를 못 받고, 그때는 앱이 붙지 못하는 이유가 밖에서 보이지 않는다.
#
# MAP_PROJECT_EDGE_DOMAIN: 앞단이 인증서를 받을 주소. 운영과 시험이 다른 이름을 쓴다.
# MAP_PROJECT_EDGE_EMAIL: 인증서 만료 알림을 받을 주소.
MAP_PROJECT_EDGE_DOMAIN=
MAP_PROJECT_EDGE_EMAIL=

# ── 이미지를 받아올 곳 ───────────────────────────────────────────────────
# docker-compose.registry.yml 을 함께 얹을 때만 쓴다. 만드는 일은 다른 곳에서
# 하고 여기서는 받기만 한다 — 서버에서는 빌드가 끝나지 않는다.
#
# MAP_PROJECT_IMAGE_TAG 를 비워 두면 받아오기가 그 자리에서 멈춘다. 그게 낫다. 비운 채로
# 떠 버리면 어느 코드가 도는지 서버 어디에도 적히지 않는다. 값은 이미지를
# 만든 실행이 알려 주는 것을 그대로 옮겨 적는다.
# 이 저장소는 이미지를 게시하지 않는다. 각 서비스 레포에서 직접 빌드해 자기
# 레지스트리에 올린 뒤 그 주소를 적는다.
MAP_PROJECT_IMAGE_REGISTRY=
MAP_PROJECT_IMAGE_TAG=

# (5c) 성향별 저장 비율 통계 (선택)
# agent 가 후보 랭킹에 조금 얹는 값이다. 비우면 아무 일도 하지 않는다.
# 파일은 agent 의 eval/segment_stats.py 로 만들어 이 저장소의 segstats/ 에 두면 읽기 전용으로 붙는다.
AGENT_SEGMENT_STATS_PATH=

# user 서빙은 전용 실행 로그인으로 붙는다. 마이그레이션·부트스트랩 자격은 빈 DB 준비
# 단계(docker-compose.yml 의 db-*·user-db-*)에만 넘긴다. 값은 scripts/make-local-env.sh 가 채운다.
# 비밀번호는 64자리 16진수여야 한다(user 마이그레이션 진입점의 검사).
USER_DATABASE_USER=map_user_runtime
USER_DATABASE_PASSWORD=
USER_MIGRATION_URL=
USER_MIGRATION_USERNAME=
USER_MIGRATION_PASSWORD=
USER_BOOTSTRAP_PASSWORD=
USER_BOOTSTRAP_MARKER=

# agent 서빙은 자기 체크포인트 스키마만 읽고 쓴다. 마이그레이션 자격은 서빙에 넘기지 않는다.
AGENT_DATABASE_USER=map_agent_runtime
AGENT_DATABASE_PASSWORD=
AGENT_CHECKPOINT_MIGRATION_DSN=

# Metrics collection needs pg_monitor only; this login holds no table privileges.
MAP_PROJECT_POSTGRES_EXPORTER_DSN=
USER_APP_ENV=prod

# 배포 중에만 상류를 갈아 끼우는 자리. 관문 컨테이너가 마운트하는 경로와
# 같은 값이어야 하며, 서버에서는 checkout 밖의 상태 디렉터리를 가리킨다.
MAP_PROJECT_PROXY_UPSTREAMS_DIR=./proxy/upstreams
